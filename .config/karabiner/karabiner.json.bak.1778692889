{
  "global": {
    "show_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "Default profile",
      "selected": true,
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "iso"
      },
      "complex_modifications": {
        "rules": [
          {
            "description": "fn -> left_control",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "fn"
                },
                "to": [
                  {
                    "key_code": "left_control"
                  }
                ]
              }
            ]
          },
          {
            "description": "ctrl + p/n/f/b -> arrows",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "p",
                  "modifiers": {
                    "mandatory": [
                      "control"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "up_arrow"
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "n",
                  "modifiers": {
                    "mandatory": [
                      "control"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "down_arrow"
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "f",
                  "modifiers": {
                    "mandatory": [
                      "control"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "right_arrow"
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "b",
                  "modifiers": {
                    "mandatory": [
                      "control"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "left_arrow"
                  }
                ]
              }
            ]
          },
